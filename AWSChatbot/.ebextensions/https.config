files:
  /etc/nginx/conf.d/https.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
          listen 443 ssl;
          server_name chatbot-env.eba-wzwnk7xj.us-west-2.elasticbeanstalk.com;
          
          ssl_certificate /etc/pki/tls/certs/server.crt;
          ssl_certificate_key /etc/pki/tls/certs/server.key;
          
          location / {
              proxy_pass http://127.0.0.1:3000;
              proxy_http_version 1.1;
              proxy_set_header Upgrade $http_upgrade;
              proxy_set_header Connection 'upgrade';
              proxy_set_header Host $host;
              proxy_cache_bypass $http_upgrade;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
          }
      }

commands:
  01_create_ssl_cert:
    command: |
      if [ ! -f /etc/pki/tls/certs/server.crt ]; then
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
          -keyout /etc/pki/tls/certs/server.key \
          -out /etc/pki/tls/certs/server.crt \
          -subj "/C=US/ST=State/L=City/O=Organization/CN=chatbot-env.eba-wzwnk7xj.us-west-2.elasticbeanstalk.com"
      fi
    ignoreErrors: false
